@model Booking
@{
    ViewData["Title"] = "Book a Ticket";
}

<div class="min-h-[70vh] flex items-center justify-center py-12 px-4">
    <div class="max-w-md w-full bg-white p-8 rounded-2xl shadow-sm border border-gray-200">
        <div class="text-center mb-6">
            <i class="fa-solid fa-calendar-check text-4xl text-indigo-600 mb-2"></i>
            <h2 class="text-2xl font-bold text-gray-900">Book Your Ticket</h2>
            <p class="text-sm text-gray-500 mt-1">Select an event and confirm your booking</p>
        </div>

        <form asp-action="Create" method="post" class="space-y-5">
            <div asp-validation-summary="ModelOnly" class="p-4 rounded-lg bg-red-50 text-sm text-red-700"></div>

            <div>
                <label asp-for="EventId" class="block text-sm font-semibold text-gray-700 mb-1">Choose Event</label>
                <select asp-for="EventId" asp-items="ViewBag.EventId" class="w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 p-2.5 border bg-white">
                    <option value="">-- Select an Event --</option>
                </select>
                <span asp-validation-for="EventId" class="text-xs text-red-600 mt-1 block"></span>
            </div>

            <div>
                <label asp-for="NumberOfTickets" class="block text-sm font-semibold text-gray-700 mb-1">Number of Tickets</label>
                <input asp-for="NumberOfTickets" type="number" class="w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 p-2.5 border" placeholder="Enter quantity" />
    
                <span asp-validation-for="NumberOfTickets" class="text-xs text-red-600 mt-1 block"></span>
            </div>

            <div class="flex items-center gap-3 pt-2">
                <a asp-action="Index" asp-controller="Events" class="w-1/2 text-center py-2.5 px-4 text-sm font-medium rounded-lg text-gray-700 bg-gray-100 hover:bg-gray-200 transition">
                    Cancel
                </a>
                <button type="submit" class="w-1/2 py-2.5 px-4 text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm transition">
                    Confirm Booking
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}