@model List<Booking>
@{
    ViewData["Title"] = "Bookings";
}

<div class="sm:flex sm:items-center sm:justify-between mb-8">
    <div>
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Reservations</h1>
        <p class="mt-2 text-sm text-gray-600">Track and monitor all ticket purchases and event registrations.</p>
    </div>
    <div class="mt-4 sm:mt-0">
        <a asp-action="Create" class="inline-flex items-center justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm transition">
            <i class="fa-solid fa-ticket mr-2"></i> Book Tickets
        </a>
    </div>
</div>

<div class="bg-white shadow rounded-xl overflow-hidden border border-gray-200">
    <div class="hidden md:block overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr class="text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">
                    <th class="px-6 py-3">Event</th>
                    <th class="px-6 py-3">User ID</th>
                    <th class="px-6 py-3">Tickets</th>
                    <th class="px-6 py-3">Booking Date</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-100">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-gray-50/70 transition">
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">@(item.Event?.Name ?? "N/A")</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">@item.UserId</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">@item.NumberOfTickets</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-400">@item.BookingDate.ToString("MMM dd, yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="grid grid-cols-1 divide-y divide-gray-100 md:hidden">
        @foreach (var item in Model)
        {
            <div class="p-4 space-y-2">
                <div class="flex justify-between items-center">
                    <span class="text-sm font-bold text-gray-900">@(item.Event?.Name ?? "Unknown Event")</span>
                    <span class="px-2.5 py-1 text-xs font-semibold rounded-md bg-green-50 text-green-700">@item.NumberOfTickets Tickets</span>
                </div>
                <div class="flex justify-between text-xs text-gray-500">
                    <span>User Key: @item.UserId</span>
                    <span>@item.BookingDate.ToShortDateString()</span>
                </div>
            </div>
        }
    </div>
</div>