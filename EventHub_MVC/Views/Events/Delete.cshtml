@model Event
@{
    ViewData["Title"] = "Delete Event";
}

<div class="max-w-md mx-auto bg-white p-8 rounded-2xl shadow-sm border border-gray-200 text-center">
    <div class="w-16 h-16 bg-red-50 rounded-full flex items-center justify-center mx-auto mb-4 text-red-600">
        <i class="fa-solid fa-triangle-exclamation text-2xl"></i>
    </div>
    <h2 class="text-xl font-bold text-gray-900 mb-2">Confirm Destruction</h2>
    <p class="text-sm text-gray-500 mb-6">Are you completely sure you want to remove <span class="font-semibold text-gray-800">"@Model.Name"</span>? This action is permanent and cannot be rolled back.</p>

    <form asp-action="Delete" method="post" class="flex items-center justify-center space-x-3">
        <input type="hidden" asp-for="Id" />
        <a asp-action="Index" class="px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 transition">Keep Event</a>
        <button type="submit" class="px-4 py-2 text-sm font-medium rounded-lg text-white bg-red-600 hover:bg-red-700 shadow-sm transition">Delete Forever</button>
    </form>
</div>