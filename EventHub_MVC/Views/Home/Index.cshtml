@{
    ViewData["Title"] = "Dashboard";
}

<div class="bg-gradient-to-r from-indigo-600 to-purple-600 rounded-3xl text-white p-8 md:p-12 shadow-lg mb-10 relative overflow-hidden">
    <div class="max-w-xl relative z-10">
        <h1 class="text-4xl md:text-5xl font-black tracking-tight leading-tight">Welcome to EventHub Management</h1>
        <p class="mt-4 text-indigo-100 text-lg">Streamline your scheduling, manage venue capacities, and track ticket reservations instantly from one unified platform.</p>
        <div class="mt-6 flex flex-wrap gap-4">
            <a asp-controller="Bookings" asp-action="Create" class="bg-white text-indigo-600 font-semibold px-5 py-3 rounded-xl shadow hover:bg-indigo-5 transition">
                <i class="fa-solid fa-ticket mr-2"></i> Book New Ticket
            </a>
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Events" asp-action="Create" class="bg-indigo-500/30 text-white border border-indigo-400/40 font-semibold px-5 py-3 rounded-xl hover:bg-indigo-500/50 transition">
                    <i class="fa-solid fa-plus mr-2"></i> Create Event
                </a>
            }
        </div>
    </div>
    <div class="absolute -right-10 -bottom-10 text-indigo-500/10 text-[200px] pointer-events-none font-bold select-none">
        <i class="fa-solid fa-chart-line"></i>
    </div>
</div>

<div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-10">
    <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm flex items-center justify-between hover:shadow-md transition">
        <div>
            <span class="text-xs font-bold text-gray-400 uppercase tracking-wider block">Active Events</span>
            <span class="text-3xl font-black text-gray-900 mt-1 block">@ViewBag.TotalEvents</span>
        </div>
        <div class="bg-indigo-50 p-4 rounded-xl text-indigo-600 text-xl">
            <i class="fa-solid fa-calendar-days"></i>
        </div>
    </div>

    <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm flex items-center justify-between hover:shadow-md transition">
        <div>
            <span class="text-xs font-bold text-gray-400 uppercase tracking-wider block">Total Bookings</span>
            <span class="text-3xl font-black text-gray-900 mt-1 block">@ViewBag.TotalBookings</span>
        </div>
        <div class="bg-emerald-50 p-4 rounded-xl text-emerald-600 text-xl">
            <i class="fa-solid fa-receipt"></i>
        </div>
    </div>

    <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm flex items-center justify-between hover:shadow-md transition">
        <div>
            <span class="text-xs font-bold text-gray-400 uppercase tracking-wider block">Tickets Issued</span>
            <span class="text-3xl font-black text-gray-900 mt-1 block">@ViewBag.TotalTicketsSold</span>
        </div>
        <div class="bg-amber-50 p-4 rounded-xl text-amber-600 text-xl">
            <i class="fa-solid fa-ticket-simple"></i>
        </div>
    </div>
</div>
@if(User.IsInRole("Admin"))
{
    <div class="bg-white p-8 rounded-2xl border border-gray-200 shadow-sm">
        <h2 class="text-xl font-bold text-gray-900 mb-6">Quick Navigation Hub</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <a asp-controller="Events" asp-action="Index" class="p-4 rounded-xl border border-gray-100 bg-gray-50/50 hover:bg-indigo-50/50 hover:border-indigo-200 group transition">
                <h3 class="font-bold text-gray-800 group-hover:text-indigo-600">Events Catalog &rarr;</h3>
                <p class="text-xs text-gray-500 mt-1">Browse upcoming events, check timelines, configurations, and remaining seat availability.</p>
            </a>

            <a asp-controller="Bookings" asp-action="Index" class="p-4 rounded-xl border border-gray-100 bg-gray-50/50 hover:bg-indigo-50/50 hover:border-indigo-200 group transition">
                <h3 class="font-bold text-gray-800 group-hover:text-indigo-600">Reservation Database &rarr;</h3>
                <p class="text-xs text-gray-500 mt-1">Audit ticket purchases, search by system accounts, and process new bookings.</p>
            </a>

            <a asp-controller="Venues" asp-action="Index" class="p-4 rounded-xl border border-gray-100 bg-gray-50/50 hover:bg-indigo-50/50 hover:border-indigo-200 group transition">
                <h3 class="font-bold text-gray-800 group-hover:text-indigo-600">Staging Venues &rarr;</h3>
                <p class="text-xs text-gray-500 mt-1">Configure structural deployment halls, map locations, and link corporate asset entries.</p>
            </a>
        </div>
    </div>
}