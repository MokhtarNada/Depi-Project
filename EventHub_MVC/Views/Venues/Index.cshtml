@model List<Venue>
@{
    ViewData["Title"] = "Venues";
}

<div class="sm:flex sm:items-center sm:justify-between mb-8">
    <div>
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Venues</h1>
        <p class="mt-2 text-sm text-gray-600">Manage staging locations, spaces, and destinations.</p>
    </div>
    @if(User.IsInRole("Admin"))
    {
        <div class="mt-4 sm:mt-0">
            <a asp-action="Create" class="inline-flex items-center justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm transition">
                <i class="fa-solid fa-map-location-dot mr-2"></i> Add Venue
            </a>
        </div>
    }
</div>

<div class="bg-white shadow rounded-xl overflow-hidden border border-gray-200">
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr class="text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">
                    <th class="px-6 py-3">Venue Name</th>
                    <th class="px-6 py-3">Location Address</th>
                    <th class="px-6 py-3">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-100">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-gray-50/70 transition">
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">@item.Name</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">@item.Location</td>
                        @if(User.IsInRole("Admin"))
                        {
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 space-x-4">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="text-indigo-600 hover:text-indigo-900 font-medium">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="text-red-600 hover:text-red-900 font-medium">Delete</a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>