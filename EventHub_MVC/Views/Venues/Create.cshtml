@model Venue
@{
    ViewData["Title"] = "Create Venue";
}

<div class="max-w-xl mx-auto bg-white p-8 rounded-2xl shadow-sm border border-gray-200">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Create New Venue</h2>

    <form asp-action="Create" method="post" class="space-y-5">
        <div asp-validation-summary="ModelOnly" class="p-4 rounded-lg bg-red-50 text-sm text-red-700"></div>

        <div>
            <label asp-for="Name" class="block text-sm font-semibold text-gray-700 mb-1">Venue Name</label>
            <input asp-for="Name" class="w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 p-2.5 border" placeholder="e.g. Grand Plaza Arena" />
            <span asp-validation-for="Name" class="text-xs text-red-600 mt-1"></span>
        </div>

        <div>
            <label asp-for="Location" class="block text-sm font-semibold text-gray-700 mb-1">Location Address</label>
            <input asp-for="Location" class="w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 p-2.5 border" placeholder="e.g. 123 Innovation Way, NY" />
            <span asp-validation-for="Location" class="text-xs text-red-600 mt-1"></span>
        </div>

        <div class="flex items-center justify-end space-x-3 pt-4 border-t border-gray-100">
            <a asp-action="Index" class="px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 transition">Cancel</a>
            <button type="submit" class="px-4 py-2 text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm transition">Save Venue</button>
        </div>
    </form>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}